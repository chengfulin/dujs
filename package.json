{
  "name": "dujs",
  "description": "Support to model intra-procedural, inter-procedural, intra-page and inter-page data flow on client-side JavaScript programs",
  "version": "1.1.0",
  "maintainers": [
    {
      "name": "chengfulin",
      "email": "chengfulin0806@gmail.com"
    }
  ],
  "bin": {
    "dujs": "bin/dujs.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "mocha \"tests/analyses/*.js\" \"tests/dujs/*.js\" tests/esgraph/flownodetest.js tests/esgraph/flownodefactory.js tests/esgraph/test.js",
    "lint": "eslint .",
    "coverage": "c8 --reporter=text --reporter=lcov npm test",
    "doc": "jsdoc lib/namespace.js lib/dujs lib/esgraph/flownode.js lib/esgraph/flownodefactory.js -d doc"
  },
  "dependencies": {
    "espree": "^11.2.0",
    "walkes": "^0.2.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "esgraph": "^0.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdoc": "^4.0.5",
    "mocha": "^12.0.3",
    "should": "^13.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/chengfulin/dujs.git"
  },
  "license": "MIT AND LGPL-3.0-only",
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.7"
  }
}
