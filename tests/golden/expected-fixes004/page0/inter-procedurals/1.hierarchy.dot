digraph Hierarchy {
node [shape="box"]
label = "inter-procedural: $DOMAIN.$PAGE_0"
h0 [label="$DOMAIN.$PAGE_0"]
h1 [label="$DOMAIN.$PAGE_0.P"]
h2 [label="$DOMAIN.$PAGE_0.$ANONYMOUS_FUN_0"]
h3 [label="$DOMAIN.$PAGE_0.$ANONYMOUS_FUN_1"]
h4 [label="$DOMAIN.$PAGE_0.$ANONYMOUS_FUN_2"]
h5 [label="$DOMAIN.$PAGE_0.$ANONYMOUS_FUN_3"]
h6 [label="$DOMAIN.$PAGE_0.$ANONYMOUS_FUN_4"]
h7 [label="$DOMAIN.$PAGE_0.$ANONYMOUS_FUN_5"]
h8 [label="$DOMAIN.$PAGE_0.$ANONYMOUS_FUN_6"]
h9 [label="$DOMAIN.$PAGE_0.log"]
h10 [label="$DOMAIN.$PAGE_0.h"]
h0 -> h1 [color="blue", label="call"]
h1 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h2 [color="blue", label="call"]
h2 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h3 [color="blue", label="call"]
h3 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h4 [color="blue", label="call"]
h4 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h5 [color="blue", label="call"]
h5 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h6 [color="blue", label="call"]
h6 -> h7 [color="blue", label="call"]
h7 -> h6 [color="blue", style="bold", label="recursive call"]
h6 -> h7 [color="blue", style="bold,dashed", label="recursive return"]
h7 -> h6 [color="blue", style="dashed", label="return"]
h6 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h7 [color="blue", label="call"]
h7 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h8 [color="blue", label="call"]
h8 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h9 [color="blue", label="call"]
h9 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h10 [color="blue", label="call"]
h10 -> h0 [color="blue", style="dashed", label="return"]
}