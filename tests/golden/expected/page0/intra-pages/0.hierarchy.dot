digraph Hierarchy {
node [shape="box"]
label = "intra-page: $DOMAIN.$PAGE_0"
h0 [label="$DOMAIN.$PAGE_0"]
h1 [label="loop", shape="ellipse", style="filled", fillcolor="yellow"]
h2 [label="$DOMAIN.$PAGE_0.onLoad"]
h3 [label="$DOMAIN.$PAGE_0.onAdd"]
h4 [label="$DOMAIN.$PAGE_0.onModeChange"]
h0 -> h1 [label="loop"]
h1 -> h2 [color="green", label="onEvent"]
h2 -> h1 [color="blue", style="dashed", label="return"]
h1 -> h3 [color="green", label="onEvent"]
h3 -> h1 [color="blue", style="dashed", label="return"]
h1 -> h4 [color="green", label="onEvent"]
h4 -> h1 [color="blue", style="dashed", label="return"]
}