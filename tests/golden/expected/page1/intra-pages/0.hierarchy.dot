digraph Hierarchy {
node [shape="box"]
label = "intra-page: $DOMAIN.$PAGE_1"
h0 [label="$DOMAIN.$PAGE_1"]
h1 [label="loop", shape="ellipse", style="filled", fillcolor="yellow"]
h2 [label="$DOMAIN.$PAGE_1.onLoad"]
h3 [label="$DOMAIN.$PAGE_1.onClear"]
h0 -> h1 [label="loop"]
h1 -> h2 [color="green", label="onEvent"]
h2 -> h1 [color="blue", style="dashed", label="return"]
h1 -> h3 [color="green", label="onEvent"]
h3 -> h1 [color="blue", style="dashed", label="return"]
}