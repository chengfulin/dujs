digraph Hierarchy {
node [shape="box"]
label = "inter-procedural: $DOMAIN.$PAGE_0.generateStory"
h0 [label="$DOMAIN.$PAGE_0.generateStory"]
h1 [label="$DOMAIN.$PAGE_0.returnRandomStoryString"]
h2 [label="$DOMAIN.$PAGE_0.randomValueFromArray"]
h0 -> h1 [color="blue", label="call"]
h1 -> h2 [color="blue", label="call"]
h2 -> h1 [color="blue", style="dashed", label="return"]
h1 -> h0 [color="blue", style="dashed", label="return"]
}