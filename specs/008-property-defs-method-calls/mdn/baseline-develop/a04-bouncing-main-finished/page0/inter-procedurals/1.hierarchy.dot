digraph Hierarchy {
node [shape="box"]
label = "inter-procedural: $DOMAIN.$PAGE_0"
h0 [label="$DOMAIN.$PAGE_0"]
h1 [label="$DOMAIN.$PAGE_0.random"]
h2 [label="$DOMAIN.$PAGE_0.randomRGB"]
h3 [label="$DOMAIN.$PAGE_0.$ANONYMOUS_FUN_0"]
h4 [label="$DOMAIN.$PAGE_0.loop"]
h0 -> h1 [color="blue", label="call"]
h1 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h2 [color="blue", label="call"]
h2 -> h1 [color="blue", label="call"]
h1 -> h2 [color="blue", style="dashed", label="return"]
h2 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h3 [color="blue", label="call"]
h3 -> h0 [color="blue", style="dashed", label="return"]
h0 -> h4 [color="blue", label="call"]
h4 -> h0 [color="blue", style="dashed", label="return"]
}