digraph CFG {
node [shape="box"]
label = "function $DOMAIN.$PAGE_0.randomRGB"
n99 [label="entry", shape="ellipse", style="filled", fillcolor="yellow"]
n100 [label="25"]
n101 [label="exit", shape="ellipse", style="filled", fillcolor="yellow"]
n99 -> n100 []
n100 -> n101 []
n100 -> n101 [color="red", label="exception"]
}