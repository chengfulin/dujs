digraph CFG {
node [shape="box"]
label = "function $DOMAIN.$PAGE_0.random"
n84 [label="entry", shape="ellipse", style="filled", fillcolor="yellow"]
n85 [label="18"]
n86 [label="19"]
n87 [label="exit", shape="ellipse", style="filled", fillcolor="yellow"]
n84 -> n85 []
n85 -> n86 []
n85 -> n87 [color="red", label="exception"]
n86 -> n87 []
}